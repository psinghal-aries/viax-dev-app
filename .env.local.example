# ─────────────────────────────────────────────────────────────────────────────
# Local runner env — dev-tools/local-runner/.env.dev.local  (twou / dev)
# Created by install.sh from this template. Non-secret dev values are pre-filled;
# fill in the empty SECRET values from the dev Vault. Grouped by concern — you only
# need the group(s) the function you're running actually uses (platform-auth is always
# required). This file is git-ignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
PORT=3000

# ── viax platform auth (ALL functions) ──
API_GW_URL=https://api.twou.dev.viax.io/graphql
IAM_URL=https://auth.twou.dev.viax.io/realms/twou/protocol/openid-connect/token
VAULT_SERVICE_CUSTOMER_CLIENT_ID=bcore
VAULT_SERVICE_CUSTOMER_CLIENT_SECRET=ZlGAy97mw1arVjNdSS7cpKbLtPnD7B3y
KV_URL=https://bcore.twou.dev.viax.tech/api/kv

# ── Stripe (checkout / webhook / subscription functions) ──
STRIPE_SECRET_KEY=                             # SECRET — from Vault (sk_test_…)
STRIPE_WEBHOOK_SECRET=                         # SECRET — from Vault (whsec_…)
STRIPE_TRIAL_DAYS=7
STRIPE_TRIAL_VIAX_MANAGED=true
WEBHOOK_FUNCTION_URL=http://rs-stripe-webhook.twou.svc.cluster.local

# ── edX identity / token exchange (rs-edx-exchange, fn-edx-userinfo, rs-edx-provision-demo) ──
EDX_BASE_URL=https://courses.stage.edx.org
EDX_JWKS_URL=                                  # public JWKS URL — from Vault/edX config
EDX_CLIENT_ID=                                 # from Vault
EDX_CLIENT_SECRET=                             # SECRET — from Vault
EDX_EXCHANGE_CLIENT_ID=                        # from Vault
EDX_EXCHANGE_CLIENT_SECRET=                    # SECRET — from Vault

# ── LMS Enrollment API (enrollment functions — SUBS-318/319/320) ──
# Runs against the mock unless set to exactly "false" (live write gated to SUBS-415/452).
LMS_ENROLLMENT_MOCK=true

# ── edX Partner API (catalog sync — SUBS-586/587/588) ──
PARTNER_API_BASE_URL=https://api.stg.partner.2u.com
PARTNER_API_KEY=ig5v2NFyjS9GaSk6uDDKB8H4vwTFAKh25lRqhQAW
PARTNER_API_CACHE_TTL_MS=300000
PARTNER_API_MAX_PAGES=500
PARTNER_INCLUSION_FIELD=enterprise_subscription_inclusion

# ── Conductor (ct-catalog-sync + workflow starters) ──
# In-cluster address (works for deployed functions). A LOCAL run can't reach it — use the
# public ingress https://conductor.twou.dev.viax.io if you need Conductor from your machine.
CONDUCTOR_URL=http://conductor.twou

# ── Segment analytics (enabled unless set to exactly "false") ──
SEGMENT_ENABLED=true
SEGMENT_HOST=                                  # from Vault
SEGMENT_WRITE_KEY_CHECKOUT=                    # SECRET — from Vault
SEGMENT_WRITE_KEY_ENROLLMENT=                  # SECRET — from Vault
SEGMENT_WRITE_KEY_MANAGE=                      # SECRET — from Vault

# ── Optional tunables (sensible in-code defaults; set only to override) ──
CART_ABANDON_THRESHOLD_HOURS=                  # ct-abandon-stale-carts idle threshold
MAX_CHECKOUT_RETRY_ATTEMPTS=                   # empty = unlimited retries
PARTNER_API_RESOURCE_SUFFIX=-stg